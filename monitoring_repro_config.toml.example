# Fichier listant les paramètres du module et leurs valeurs par défaut
# A copier/renommer en monitoring_repro_config.toml dans le dossier config/ de GeoNature

# Liste des pages (routes) du module. Chaque page combine les sites d'un ou
# plusieurs sous-modules gn_module_monitoring sur une même carte ; chaque
# sous-module garde ses propres critères de succès (legend_field,
# legend_values), et déclare ses vues d'export gn_module_monitoring
# (site_export_name, visit_export_name), obligatoires : les sites et les visites sont
# chargés via /exports/csv/<module_code>/<method>, jamais via l'API générique
# sites/geometries + visits.

# Page combinant 2 sous-modules : aigle + domaine_vital.
[[PAGES]]
page_code = "aigle_domaine_vital"
page_label = "Aigle & Domaines vitaux"

  # AIGLE
  [[PAGES.modules]]
  module_code = "AIGLE"
  module_label = "Aigle royal"
  legend_field = "resultat_reproduction"
  # Vues gn_monitoring.v_export_AIGLE_sites / v_export_AIGLE_visits
  site_export_name = "sites"
  visit_export_name = "visits"

    [[PAGES.modules.legend_values]]
    value = ["succes"]
    label = "Succès"
    color = "#66bb6a"

    [[PAGES.modules.legend_values]]
    value = ["echec"]
    label = "Échec"
    color = "#e57373"

    # "*no_data" : site sans aucune visite sur l'année. Sans cette entrée, un
    # tel site n'a ni couleur ni libellé.
    [[PAGES.modules.legend_values]]
    value = ["*no_data"]
    label = "Pas de donnée"
    color = "#bdbdbd"

  # DOMAINE vital
  [[PAGES.modules]]
  module_code = "DOMAINE_VITAL"
  module_label = "Domaines vitaux"
  legend_field = "resultat_reproduction"
  site_export_name = "sites"
  visit_export_name = "visits"

    [[PAGES.modules.legend_values]]
    value = ["1 jeune envolé", "2 jeunes envolés"]
    label = "Succès"
    color = "#66bb6a"

    [[PAGES.modules.legend_values]]
    value = ["echec"]
    label = "Échec"
    color = "#e57373"

    [[PAGES.modules.legend_values]]
    # la valeur *no_match permet de mettre une légende sur les visite qui ne match aucune valeur de légende.
    # Dans ce cas, la couleur #bdbdbd sera appliqué si resultat_reproduction = pas de conclusion possible ou une autre valeur non renseigné dans la conf
    value = ["pas de conclusion possible", "*no_match"]
    label = "Pas de conclustion possible"
    color = "#bdbdbd"

    [[PAGES.modules.legend_values]]
    # la wild card *no_data correspond à "aucune visite", elle peut être couplé à une autre valeur, ici "non suivi"
    value = ["non_suivi", "*no_data"]
    label = "Pas de donnée"
    color = "#bdbdbd"

# Page dédiée à un seul sous-module : gypaète.
[[PAGES]]
page_code = "gypaete"
page_label = "Gypaète barbu"

  [[PAGES.modules]]
  module_code = "GYPAETE"
  module_label = "Gypaète barbu"
  legend_field = "resultat_reproduction"
  site_export_name = "sites"
  visit_export_name = "visits"

    [[PAGES.modules.legend_values]]
    value = ["envol"]
    label = "Envol réussi"
    color = "#66bb6a"

    [[PAGES.modules.legend_values]]
    value = ["echec"]
    label = "Échec"
    color = "#e57373"

    [[PAGES.modules.legend_values]]
    value = ["*no_data"]
    label = "Pas de donnée"
    color = "#bdbdbd"
